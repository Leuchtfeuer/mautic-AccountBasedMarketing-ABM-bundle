{# Check to see if the entire page should be displayed or just main content #}
{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent %}company_segments{% endblock %}{# used in the javascript file, most likely the methods like company_segments+'OnLoad' #}

{% block headerTitle %}{{ 'mautic.company_segments.header.index'|trans }}{% endblock %}

{% block actions %}
    {{ include('@MauticCore/Helper/page_actions.html.twig', {
        'templateButtons': {'new': permissions['lead:lists:create']},
        'routeBase': constant('MauticPlugin\\LeuchtfeuerAccountBasedMarketingAbmBundle\\Model\\CompanySegmentModel::PROPERTIES_FIELD'),
        'langVar': 'company_segments',
    }) }}
{% endblock %}

{% block content %}
    {% set listCommand = constant('MauticPlugin\\LeuchtfeuerAccountBasedMarketingAbmBundle\\Model\\CompanySegmentModel::SEARCH_COMMAND')|default('mautic.company_segments.searchcommand.list')|trans %}

    {% if isIndex %}
        <div class="panel panel-default bdr-t-wdh-0">
        {{ include('@MauticCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'searchHelp': 'mautic.company_segments.help.searchcommands',
            'action': currentRoute,
            'filters': filters|default([]),
        }) }}
        <div class="page-list">
    {% endif %}

    {{ include('@LeuchtfeuerAccountBasedMarketingAbm/CompanySegment/list.html.twig') }}

    {% if isIndex %}
        </div>
        </div>
    {% endif %}
{% endblock %}
